# Compose 与后端共用此文件；从仓库根目录运行 docker compose --env-file backend/.env ...。
# 首次初始化数据库的密码，必须填写；建议使用随机字母和数字。
POSTGRES_PASSWORD=
# 本机 5432 已被占用时可改为 5433，同时修改下面连接 URL 的端口。
POSTGRES_PORT=5432

# 将占位密码替换为上面的 POSTGRES_PASSWORD，端口与 POSTGRES_PORT 一致。
# 若使用现有本机数据库，请改成实际连接信息；密码含 URL 特殊字符时需百分号编码。
DATABASE_URL=postgresql+psycopg://aiops:replace_with_your_password@127.0.0.1:5432/aiops

# DeepSeek API（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent 长期记忆：成功对话后提炼稳定偏好、环境约定、决策和经验，默认开启。
MEMORY_ENABLED=true
MEMORY_RETRIEVAL_LIMIT=6
MEMORY_CANDIDATE_LIMIT=200
MEMORY_SHORT_TERM_MAX_CHARS=120000
MEMORY_CONVERSATION_SUMMARY_ENABLED=true
MEMORY_CONVERSATION_SUMMARY_TRIGGER_CHARS=80000
MEMORY_CONVERSATION_RECENT_CHARS=40000
MEMORY_CONVERSATION_SUMMARY_INPUT_CHARS=60000
MEMORY_CONVERSATION_SUMMARY_MAX_CHARS=8000

# 生成目标服务器部署包时写入的初始 root 服务控制白名单，完整 .service 单元用逗号分隔。
# 部署后，服务目录的“控制授权”开关会通过固定策略网关同步增删；旧变量仍兼容读取。
SSH_SERVICE_CONTROL_ALLOWLIST=

# Operation Broker 本地单用户身份。接入真正的登录鉴权前，角色只允许由服务端配置。
OPERATION_ACTOR_ID=local-user
OPERATION_ACTOR_ROLE=admin
# 仅对明确的非生产环境 + medium 操作生效；默认仍要求人工审批。
OPERATION_AUTO_APPROVE_NON_PRODUCTION_MEDIUM=false
