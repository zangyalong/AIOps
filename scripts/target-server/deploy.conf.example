# AIOMS 目标服务器一键部署配置
# 复制为 deploy.conf 后修改；不要在值两侧添加引号。

# 必填：AIOMS 后端通过 SSH 登录目标服务器时使用的现有 Linux 用户。
# 部署脚本不会创建该用户，也不会修改 authorized_keys。
AIOMS_SSH_USER=aioms

# bootstrap 创建的独立部署用户，只用于审批后的配置写 Tool。
AIOMS_DEPLOY_USER=aioms-deploy

# Agent 经人工审批后允许启停/重启的 systemd 单元。必须写完整 .service 名；留空拒绝全部。
SERVICE_CONTROL_ALLOWLIST=

# 是否在目标服务器安装 Alloy 并采集日志：true / false
ENABLE_ALLOY=true

# ENABLE_ALLOY=true 时必填：服务目录中登记的服务器名称。
SERVER_NAME=web01

# ENABLE_ALLOY=true 时必填：目标服务器能够访问的中央 Loki 推送地址。
LOKI_PUSH_URL=http://monitor.example.com:3100/loki/api/v1/push

# 可选：Alloy 软件包下载入口。APT 默认使用 Grafana 官方源；RPM 默认临时使用清华 TUNA 镜像。
# APT 机器只使用 ALLOY_APT_*；RHEL/Fedora 机器只使用 ALLOY_RPM_*。
# RPM 镜像中的软件包仍使用 Grafana 官方 GPG key 校验；安装结束后会恢复服务器原有 DNF repo。
# 留空也会回退到下方默认地址，不要填写来源不明的公共镜像。
ALLOY_APT_REPO_URL=https://apt.grafana.com
ALLOY_APT_GPG_KEY_URL=https://apt.grafana.com/gpg-full.key
ALLOY_RPM_REPO_URL=https://mirrors.tuna.tsinghua.edu.cn/grafana/yum/rpm
ALLOY_RPM_GPG_KEY_URL=https://rpm.grafana.com/gpg.key

# 可选：仅本次安装 Alloy 软件包使用的 HTTP(S) 代理；留空表示直连，不会写入系统全局代理配置。
# 若代理地址含账号密码，deploy.conf 和生成的安装包都应按敏感文件保管。
ALLOY_PACKAGE_PROXY_URL=

# 首次安装留空：先安装 discovery 和 Alloy 基础组件，服务注册后由 AI 自动生成并审批应用。
# 管理员已有审核过的映射时，也可以填写相对路径或绝对路径直接部署。
ALLOY_SERVICE_MAP=

# 映射中存在 log_source=docker 时必须为 true。
# Docker socket 权限很高，请只在确实需要采集容器日志时开启。
ALLOW_DOCKER_SOCKET=false

# 首次无映射时必须为 false。AI 审批应用服务映射后会校验配置并启动或重载 Alloy。
START_ALLOY=false

# 服务目录和 Prometheus 标签使用的环境名。
ENVIRONMENT=prod

# -------------------- Prometheus 指标 exporter --------------------
# 指标组件以 Docker Compose 运行。每个组件独立开关，镜像可手工升级或固定 digest。
# 默认仅在安装时通过 DaoCloud 国内代理拉取，然后恢复为下方原始镜像名；留空表示直连原仓库。
EXPORTER_IMAGE_MIRROR_PREFIX=m.daocloud.io

# 宿主机 CPU、内存、磁盘、网络等指标，默认端口 9100。
ENABLE_NODE_EXPORTER=true
NODE_EXPORTER_IMAGE=quay.io/prometheus/node-exporter:v1.11.1

# Docker 容器 CPU、内存、网络、OOM 等指标，默认端口 8080。
# cAdvisor 使用 privileged 和多个宿主机只读挂载，启用前请阅读 metrics/README.md。
ENABLE_CADVISOR=true
CADVISOR_IMAGE=ghcr.io/google/cadvisor:0.57.0
DOCKER_ROOT_DIR=/var/lib/docker

# MySQL/MariaDB 指标，默认端口 9104。
# 启用前复制并填写 metrics/mysql-exporter.my.cnf.example。
ENABLE_MYSQL_EXPORTER=false
MYSQL_EXPORTER_IMAGE=prom/mysqld-exporter:v0.19.0
MYSQL_EXPORTER_CONFIG=metrics/mysql-exporter.my.cnf
# host 表示连接宿主机数据库；也可填写数据库容器所在的已有 Docker 网络名。
MYSQL_EXPORTER_NETWORK=host

# PostgreSQL 指标，默认端口 9187。URI 不包含用户名和密码。
# 密码单独放在 POSTGRES_EXPORTER_PASSWORD_FILE 指定的文件中。
ENABLE_POSTGRES_EXPORTER=false
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:v0.19.1
POSTGRES_EXPORTER_URI=127.0.0.1:5432/postgres?sslmode=disable
POSTGRES_EXPORTER_USER=aioms_exporter
POSTGRES_EXPORTER_PASSWORD_FILE=metrics/postgres-exporter.password
POSTGRES_EXPORTER_NETWORK=host

# Redis/Valkey 指标，默认端口 9121。无认证时用户名和密码文件可留空。
ENABLE_REDIS_EXPORTER=false
REDIS_EXPORTER_IMAGE=quay.io/oliver006/redis_exporter:v1.88.0
REDIS_EXPORTER_ADDRESS=redis://127.0.0.1:6379
REDIS_EXPORTER_USER=aioms_exporter
REDIS_EXPORTER_PASSWORD_FILE=metrics/redis-exporter.password
REDIS_EXPORTER_NETWORK=host

# true：拉取镜像并启动/更新已启用 exporter；false：只生成并校验 Compose 配置。
START_EXPORTERS=true
