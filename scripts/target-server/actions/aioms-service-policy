#!/bin/bash

set -euo pipefail
PATH=/usr/sbin:/usr/bin:/sbin:/bin

fail() {
    echo "aioms-service-policy: $*" >&2
    exit 1
}

[[ $EUID -eq 0 ]] || fail "必须由 root 通过 sudoers 调用"
[[ $# -eq 2 ]] || fail "用法：aioms-service-policy add|remove SERVICE.service"

readonly ACTION="$1"
readonly SERVICE="$2"
readonly POLICY_DIR="/etc/aioms"
readonly ALLOWLIST="$POLICY_DIR/service-control.allowlist"
readonly LOCK_FILE="/run/lock/aioms-service-policy.lock"

case "$ACTION" in
    add|remove) ;;
    *) fail "不支持的动作：$ACTION" ;;
esac

[[ "$SERVICE" =~ ^[A-Za-z0-9][A-Za-z0-9_.@:-]*\.service$ ]] ||
    fail "服务名必须是明确的 systemd .service 单元"
[[ -d "$POLICY_DIR" && ! -L "$POLICY_DIR" ]] ||
    fail "策略目录不存在或不安全：$POLICY_DIR"
[[ -f "$ALLOWLIST" && ! -L "$ALLOWLIST" ]] ||
    fail "服务控制白名单不存在或不安全：$ALLOWLIST"

read -r dir_owner dir_mode < <(stat -c '%u %a' "$POLICY_DIR")
[[ "$dir_owner" == "0" ]] || fail "策略目录必须由 root 持有"
(( (8#$dir_mode & 8#022) == 0 )) || fail "策略目录不能由组或其他用户写入"

read -r owner mode < <(stat -c '%u %a' "$ALLOWLIST")
[[ "$owner" == "0" ]] || fail "白名单必须由 root 持有"
(( (8#$mode & 8#022) == 0 )) || fail "白名单不能由组或其他用户写入"

exec 9>"$LOCK_FILE"
flock -x 9

entries=()
while IFS= read -r raw || [[ -n "$raw" ]]; do
    line="${raw%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    [[ "$line" =~ ^[A-Za-z0-9][A-Za-z0-9_.@:-]*\.service$ ]] ||
        fail "现有白名单包含不合法条目：$line"
    entries+=("$line")
done <"$ALLOWLIST"

if [[ "$ACTION" == "add" ]]; then
    load_state="$(systemctl show --property=LoadState --value -- "$SERVICE" 2>&1)" ||
        fail "无法核对服务 $SERVICE：$load_state"
    [[ "$load_state" == "loaded" ]] ||
        fail "服务 $SERVICE 未加载（LoadState=$load_state）"
    entries+=("$SERVICE")
fi

tmp="$(mktemp "$POLICY_DIR/.service-control.allowlist.XXXXXX")"
cleanup() {
    rm -f -- "$tmp"
}
trap cleanup EXIT

if [[ "$ACTION" == "add" ]]; then
    printf '%s\n' "${entries[@]}" | sort -u >"$tmp"
else
    for entry in "${entries[@]}"; do
        [[ "$entry" == "$SERVICE" ]] || printf '%s\n' "$entry"
    done | sort -u >"$tmp"
fi

chown root:root "$tmp"
chmod 0644 "$tmp"
mv -f -- "$tmp" "$ALLOWLIST"
trap - EXIT

if [[ "$ACTION" == "add" ]]; then
    grep -Fxq -- "$SERVICE" "$ALLOWLIST" || fail "加入白名单后复核失败"
    echo "已将 $SERVICE 加入目标服务器服务控制白名单。"
else
    if grep -Fxq -- "$SERVICE" "$ALLOWLIST"; then
        fail "移出白名单后复核失败"
    fi
    echo "已将 $SERVICE 移出目标服务器服务控制白名单。"
fi
