#!/bin/bash

set -euo pipefail
PATH=/usr/sbin:/usr/bin:/usr/local/bin:/sbin:/bin
AIOMS_FILE_GATEWAY="aioms-file-write"
readonly COMMON="/usr/local/libexec/aioms/file-common"
[[ -f "$COMMON" && ! -L "$COMMON" ]] || {
    echo "aioms-file-write: 缺少 root 所有的公共校验器" >&2
    exit 1
}
# shellcheck source=aioms-file-common
source "$COMMON"

require_root_gateway
validate_policy_file
if [[ $# -eq 6 && "$1" == "config-apply" ]]; then
    target="$(canonical_existing_path "$2")"
    expected_sha="$3"
    config_format="$4"
    selector="$5"
    value_json="$6"
    (( ${#config_format} <= 16 && ${#selector} <= 1024 && ${#value_json} <= 8192 )) ||
        file_fail "结构化补丁参数过长"
    reject_sensitive_path "$target"
    validate_text_file "$target"
    validate_config_patch_helper
    policy_allows_write "$target" || file_fail "文件未获得精确写入授权：$target"
    [[ "$expected_sha" =~ ^[a-f0-9]{64}$ ]] || file_fail "旧内容 SHA-256 格式不合法"

    exec 9>/run/lock/aioms-file-write.lock
    flock -x 9
    current_sha="$(sha256sum "$target" | awk '{print $1}')"
    [[ "$current_sha" == "$expected_sha" ]] ||
        file_fail "目标文件在预览后已变化，已拒绝补丁（当前 SHA-256：$current_sha）"

    readonly BACKUP_ROOT="/var/lib/aioms/file-backups"
    path_key="$(printf '%s' "$target" | sha256sum | awk '{print $1}')"
    backup_dir="$BACKUP_ROOT/$path_key"
    install -d -o root -g root -m 0700 "$backup_dir"
    timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
    backup="$backup_dir/${timestamp}-${current_sha}"

    target_dir="$(dirname -- "$target")"
    tmp="$(mktemp "$target_dir/.aioms-config.XXXXXX")"
    cleanup_config_patch() { rm -f -- "$tmp"; }
    trap cleanup_config_patch EXIT
    patch_result="$(
        "$CONFIG_PATCH_PYTHON" "$CONFIG_PATCH_HELPER" \
            apply "$target" "$tmp" "$config_format" "$selector" "$value_json"
    )"
    validate_text_file "$tmp"
    [[ "$(sha256sum "$target" | awk '{print $1}')" == "$expected_sha" ]] ||
        file_fail "目标文件在生成补丁期间发生变化，已拒绝替换"
    cp -a -- "$target" "$backup"
    chown --reference="$target" "$tmp"
    chmod --reference="$target" "$tmp"
    mv -f -- "$tmp" "$target"
    trap - EXIT

    new_sha="$(sha256sum "$target" | awk '{print $1}')"
    echo "已原子应用结构化配置补丁：$target"
    echo "SELECTOR=$selector"
    echo "BACKUP=$backup"
    echo "SHA256=$new_sha"
    printf 'PATCH_RESULT=%s\n' "$patch_result"
    exit 0
fi

[[ $# -eq 4 && "$1" == "apply" ]] ||
    file_fail "用法：aioms-file-write apply TARGET EXPECTED_SHA256 TOKEN | config-apply TARGET EXPECTED_SHA256 FORMAT SELECTOR VALUE_JSON"
target="$(canonical_existing_path "$2")"
expected_sha="$3"
token="$4"
reject_sensitive_path "$target"
validate_text_file "$target"
policy_allows_write "$target" || file_fail "文件未获得精确写入授权：$target"
[[ "$expected_sha" =~ ^[a-f0-9]{64}$ ]] || file_fail "旧内容 SHA-256 格式不合法"
[[ "$token" =~ ^[a-f0-9]{32}$ ]] || file_fail "上传令牌格式不合法"

readonly INCOMING_DIR="/var/lib/aioms/file-incoming"
payload="$INCOMING_DIR/$token"
[[ -f "$payload" && ! -L "$payload" ]] || file_fail "找不到安全的上传内容"
payload_owner="$(stat -c '%U' "$payload")"
[[ -n "${SUDO_USER:-}" && "$payload_owner" == "$SUDO_USER" ]] ||
    file_fail "上传内容必须由当前 AIOMS SSH 用户持有"
validate_text_file "$payload"
if LC_ALL=C grep -Fq '[已脱敏]' "$payload"; then
    file_fail "新内容含脱敏占位符，禁止覆盖真实配置"
fi
if LC_ALL=C grep -q -- '-----BEGIN .*PRIVATE KEY-----' "$payload"; then
    file_fail "禁止通过 Agent 写入私钥"
fi

exec 9>/run/lock/aioms-file-write.lock
flock -x 9
current_sha="$(sha256sum "$target" | awk '{print $1}')"
[[ "$current_sha" == "$expected_sha" ]] ||
    file_fail "目标文件在预览后已变化，已拒绝覆盖（当前 SHA-256：$current_sha）"

readonly BACKUP_ROOT="/var/lib/aioms/file-backups"
path_key="$(printf '%s' "$target" | sha256sum | awk '{print $1}')"
backup_dir="$BACKUP_ROOT/$path_key"
install -d -o root -g root -m 0700 "$backup_dir"
timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
backup="$backup_dir/${timestamp}-${current_sha}"
cp -a -- "$target" "$backup"

target_dir="$(dirname -- "$target")"
tmp="$(mktemp "$target_dir/.aioms-edit.XXXXXX")"
cleanup() { rm -f -- "$tmp" "$payload"; }
trap cleanup EXIT
cat -- "$payload" >"$tmp"
chown --reference="$target" "$tmp"
chmod --reference="$target" "$tmp"
mv -f -- "$tmp" "$target"
rm -f -- "$payload"

trap - EXIT

new_sha="$(sha256sum "$target" | awk '{print $1}')"
echo "已原子更新文件：$target"
echo "BACKUP=$backup"
echo "SHA256=$new_sha"
